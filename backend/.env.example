# ── Reform Backend — Environment Variables ───────────────────────
# Copy this to .env and fill in your values.

# ── Required ─────────────────────────────────────────────────────

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# AI / LLM
ANTHROPIC_API_KEY=sk-ant-...

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_MAX_PRICE_ID=price_...

# Frontend URL (for Stripe checkout/portal redirect URLs)
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────

# Competitor analysis (TinyFish browser crawler)
TINYFISH_API_KEY=sk-tinyfish-...

# Voice / TTS (ElevenLabs)
ELEVENLABS_API_KEY=sk_...

# GitHub (for private repo access in repo-pages endpoint)
GITHUB_TOKEN=ghp_...

# AWS S3 (for caching TinyFish results — uses defaults if unset)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=reform-storage

# Port (Railway sets this automatically)
PORT=8000
